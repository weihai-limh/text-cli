{
  "server": {
    "name": "tencent-maps",
    "label": "腾讯地图",
    "transport": "sse"
  },
  "domain": {
    "semantic_id": "domain.map",
    "aliases": {"zh": "地图", "en": "map"},
    "description": "Location-based queries, routing, and geocoding;基于位置的空间查询、路线规划与地理编码"
  },
  "env_params": [],
  "tools": {
    "geocoder": {
      "semantic_id": "action.geocode",
      "aliases": {"zh": "地址解析", "en": "geocode"},
      "description": "Convert address to lat/lng;将包含省市区的地址转换为经纬度",
      "params": [
        {"name": "address", "type": "string", "position": 0, "alias_zh": "地址", "alias_en": "address"}
      ],
      "trigger_keywords": {"zh": ["地址解析", "经纬度", "坐标", "地理编码"], "en": ["geocode", "latlng", "coordinates"]},
      "adapter": "passthrough"
    },
    "reverseGeocoder": {
      "semantic_id": "action.reverse_geocode",
      "aliases": {"zh": "逆地址解析", "en": "reverse_geocode"},
      "description": "Convert lat/lng to address;将经纬度转换为结构化地址",
      "params": [
        {"name": "location", "type": "string", "position": 0, "alias_zh": "经纬度", "alias_en": "location"}
      ],
      "trigger_keywords": {"zh": ["逆地址", "反查地址", "坐标转地址", "经纬度转地址"], "en": ["reverse geocode", "location to address"]},
      "adapter": "passthrough"
    },
    "ipLocation": {
      "semantic_id": "action.ip_location",
      "aliases": {"zh": "IP定位", "en": "ip_location"},
      "description": "Get location by IP address;通过IP地址获取当前位置",
      "params": [
        {"name": "ip", "type": "string", "position": 0, "alias_zh": "IP地址", "alias_en": "ip"}
      ],
      "trigger_keywords": {"zh": ["IP定位", "IP地址", "IP归属地"], "en": ["ip location", "geoip", "ip lookup"]},
      "adapter": "passthrough"
    },
    "placeSuggestion": {
      "semantic_id": "action.place_search",
      "aliases": {"zh": "地点搜索", "en": "place_search"},
      "description": "Search places by keyword and region;按关键词和区域搜索地点",
      "params": [
        {"name": "keyword", "type": "string", "position": 0, "alias_zh": "关键词", "alias_en": "keyword"},
        {"name": "region", "type": "string", "position": 1, "alias_zh": "区域", "alias_en": "region"}
      ],
      "trigger_keywords": {"zh": ["地点搜索", "搜索地点", "查找", "附近"], "en": ["place search", "poi search", "find place"]},
      "adapter": "passthrough"
    },
    "placeSearchNearby": {
      "semantic_id": "action.nearby_search",
      "aliases": {"zh": "周边搜索", "en": "nearby_search"},
      "description": "Search places near a location;搜索指定位置周边的地点",
      "params": [
        {"name": "keyword", "type": "string", "position": 0, "alias_zh": "关键词", "alias_en": "keyword"},
        {"name": "location", "type": "string", "position": 1, "alias_zh": "位置", "alias_en": "location"}
      ],
      "trigger_keywords": {"zh": ["周边搜索", "附近", "周边", "附近搜索"], "en": ["nearby", "around", "near me"]},
      "adapter": "passthrough"
    },
    "placeDetail": {
      "semantic_id": "action.place_detail",
      "aliases": {"zh": "地点详情", "en": "place_detail"},
      "description": "Get detailed info of a place by ID;通过地点ID获取详细信息",
      "params": [
        {"name": "id", "type": "string", "position": 0, "alias_zh": "地点ID", "alias_en": "place_id"}
      ],
      "trigger_keywords": {"zh": ["地点详情", "详细信息", "查看地点", "POI详情"], "en": ["place detail", "poi detail", "place info"]},
      "adapter": "passthrough"
    },
    "placeAlongby": {
      "semantic_id": "action.along_route",
      "aliases": {"zh": "沿途搜索", "en": "along_route"},
      "description": "Search places along a route;在指定路线沿途搜索地点",
      "params": [
        {"name": "keyword", "type": "string", "position": 0, "alias_zh": "关键词", "alias_en": "keyword"},
        {"name": "route_id", "type": "string", "position": 1, "alias_zh": "路线ID", "alias_en": "route_id"}
      ],
      "trigger_keywords": {"zh": ["沿途", "沿途搜索", "路线搜索", "途经"], "en": ["along route", "on the way", "route search"]},
      "adapter": "passthrough"
    },
    "directionDriving": {
      "semantic_id": "action.driving_route",
      "aliases": {"zh": "驾车路线", "en": "driving_route"},
      "description": "Plan driving route from origin to destination;驾车路线规划，支持路况偏好",
      "params": [
        {"name": "from", "type": "string", "position": 0, "alias_zh": "起点", "alias_en": "from"},
        {"name": "to", "type": "string", "position": 1, "alias_zh": "终点", "alias_en": "to"}
      ],
      "trigger_keywords": {"zh": ["驾车", "开车", "路线规划", "导航"], "en": ["driving", "car route", "navigation"]},
      "adapter": "passthrough"
    },
    "directionBicycling": {
      "semantic_id": "action.bicycling_route",
      "aliases": {"zh": "骑行路线", "en": "bicycling_route"},
      "description": "Plan cycling route;自行车骑行路线规划",
      "params": [
        {"name": "from", "type": "string", "position": 0, "alias_zh": "起点", "alias_en": "from"},
        {"name": "to", "type": "string", "position": 1, "alias_zh": "终点", "alias_en": "to"}
      ],
      "trigger_keywords": {"zh": ["骑行", "自行车", "骑车", "骑行路线"], "en": ["bicycling", "cycling", "bike route"]},
      "adapter": "passthrough"
    },
    "directionWalking": {
      "semantic_id": "action.walking_route",
      "aliases": {"zh": "步行路线", "en": "walking_route"},
      "description": "Plan walking route;步行路线规划",
      "params": [
        {"name": "from", "type": "string", "position": 0, "alias_zh": "起点", "alias_en": "from"},
        {"name": "to", "type": "string", "position": 1, "alias_zh": "终点", "alias_en": "to"}
      ],
      "trigger_keywords": {"zh": ["步行", "走路", "徒步"], "en": ["walking", "on foot", "pedestrian"]},
      "adapter": "passthrough"
    },
    "directionTransit": {
      "semantic_id": "action.transit_route",
      "aliases": {"zh": "公交路线", "en": "transit_route"},
      "description": "Plan public transit route;公共交通路线规划，支持地铁优先、少换乘等偏好",
      "params": [
        {"name": "from", "type": "string", "position": 0, "alias_zh": "起点", "alias_en": "from"},
        {"name": "to", "type": "string", "position": 2, "alias_zh": "终点", "alias_en": "to"},
        {"name": "policy", "type": "string", "position": 1, "alias_zh": "策略", "alias_en": "policy"}
      ],
      "trigger_keywords": {"zh": ["公交", "地铁", "公共交通", "换乘"], "en": ["transit", "bus", "subway", "metro"]},
      "adapter": "passthrough"
    },
    "futureDrivingDirection": {
      "semantic_id": "action.future_driving",
      "aliases": {"zh": "未来驾车", "en": "future_driving"},
      "description": "Plan future driving route with predicted traffic;基于未来路况预测的驾车路线",
      "params": [
        {"name": "departure_time", "type": "string", "position": 0, "alias_zh": "出发时间", "alias_en": "departure_time"},
        {"name": "from", "type": "string", "position": 1, "alias_zh": "起点", "alias_en": "from"},
        {"name": "to", "type": "string", "position": 2, "alias_zh": "终点", "alias_en": "to"}
      ],
      "trigger_keywords": {"zh": ["未来出行", "预测路况", "出发时间", "预估时间"], "en": ["future driving", "predicted traffic", "eta"]},
      "adapter": "passthrough"
    },
    "matrix": {
      "semantic_id": "action.distance_matrix",
      "aliases": {"zh": "距离矩阵", "en": "distance_matrix"},
      "description": "Calculate distances between multiple points;批量计算多点间距离",
      "params": [
        {"name": "from", "type": "string", "position": 0, "alias_zh": "起点", "alias_en": "from"},
        {"name": "mode", "type": "string", "position": 1, "alias_zh": "方式", "alias_en": "mode"},
        {"name": "to", "type": "string", "position": 2, "alias_zh": "终点", "alias_en": "to"}
      ],
      "trigger_keywords": {"zh": ["距离矩阵", "距离计算", "批量距离", "多点距离"], "en": ["distance matrix", "travel distance", "route matrix"]},
      "adapter": "passthrough"
    },
    "waypointOrder": {
      "semantic_id": "action.waypoint_order",
      "aliases": {"zh": "途经点排序", "en": "waypoint_order"},
      "description": "Optimize waypoint order for route;途经点最优顺序排列",
      "params": [
        {"name": "from", "type": "string", "position": 0, "alias_zh": "起点", "alias_en": "from"},
        {"name": "to", "type": "string", "position": 2, "alias_zh": "终点", "alias_en": "to"},
        {"name": "waypoints", "type": "string", "position": 3, "alias_zh": "途经点", "alias_en": "waypoints"},
        {"name": "need_waypoint_order", "type": "string", "position": 1, "alias_zh": "排序模式", "alias_en": "order_mode"}
      ],
      "trigger_keywords": {"zh": ["途经点", "多点路线", "路线优化", "中途点"], "en": ["waypoint", "multi stop", "optimized route"]},
      "adapter": "passthrough"
    },
    "weather": {
      "semantic_id": "action.weather",
      "aliases": {"zh": "天气查询", "en": "weather"},
      "description": "Query weather by adcode or location;根据行政区划代码或位置查询天气",
      "params": [
        {"name": "adcode", "type": "string", "position": 0, "alias_zh": "行政区划代码", "alias_en": "adcode"},
        {"name": "type", "type": "string", "position": 1, "alias_zh": "预报类型", "alias_en": "type"},
        {"name": "location", "type": "string", "position": 2, "alias_zh": "位置", "alias_en": "location"}
      ],
      "trigger_keywords": {"zh": ["天气", "气温", "湿度", "下雨", "晴天"], "en": ["weather", "temperature", "forecast"]},
      "adapter": "passthrough"
    }
  }
}
