"""
MCP 路由分发 — text-cli-service 的多后端路由决策

与 copilot 的 _dispatch_mcp 同构，但适配 FastAPI 的 registry 模式。
"""

import json
import logging
import os
from typing import Optional

logger = logging.getLogger(__name__)

# 偏好配置文件路径
PREF_PATH = os.path.join(os.path.dirname(__file__), "..", "config", "routing_preferences.json")

# 路由配置：semantic mapping → MCP tool
# key: "domain;action" (canonical)
# value: {server, tool, adapter, timeout_ms}
ROUTING_CONFIG: dict[str, dict] = {
    "Git;推送": {
        "server": "github",
        "tool": "push_files",
        "adapter": "passthrough",
        "timeout_ms": 60000,
    },
    "git;push": {
        "server": "github",
        "tool": "push_files",
        "adapter": "passthrough",
        "timeout_ms": 60000,
    },
}

# 适配器注册表
# Passthrough 默认 1:1 位置参数映射到 push_files
# 对于 push_files，实际需要 5 参数，passthrough 仅提供 params[0] → branch
# 仅在验证 copilot/service 路由一致性时使用；生产用 git_push adapter


def load_preferences() -> dict:
    """加载路由偏好配置。文件不存在则返回全 local。"""
    try:
        with open(PREF_PATH, 'r', encoding='utf-8') as f:
            cfg = json.load(f)
            return cfg
    except (FileNotFoundError, json.JSONDecodeError):
        return {"default": "local", "preferences": {}}


def get_mcp_route(domain: str, action: str) -> Optional[dict]:
    """获取指令的 MCP 路由配置。无则返回 None。"""
    lookup = f"{domain};{action}"
    return ROUTING_CONFIG.get(lookup)


def decide_backend(domain: str, action: str) -> str:
    """
    决定使用哪个后端执行指令。

    Returns: "local" | "mcp"
    """
    prefs = load_preferences()
    lookup = f"{domain};{action}"

    # 1. 显式偏好优先
    if lookup in prefs.get("preferences", {}):
        return prefs["preferences"][lookup]

    # 2. 默认
    return prefs.get("default", "local")


def adapt_params(params: list, routing: dict) -> dict:
    """
    将 text-cli 位置参数适配为 MCP tool arguments。

    Passthrough: 位置参数按 push_files 需求映射
    第一个参数 = branch
    """
    adapter = routing.get("adapter", "passthrough")

    if adapter == "passthrough":
        # push_files: owner, repo, branch, files, message
        # owner/repo 从环境变量注入，files/message 用默认值
        branch = params[0] if params else "main"
        return {
            "owner": os.getenv("GITHUB_OWNER", "tide-10000"),
            "repo": os.getenv("GITHUB_REPO", "tide-test"),
            "branch": branch,
            "files": [
                {"path": "test-mcp.md", "content": "# MCP test from text-cli-service"}
            ],
            "message": f"test: MCP push via text-cli-service [{branch}]",
        }

    # 其他 adapter: 直接把 params 序列化为 JSON args
    return {"params": params}
