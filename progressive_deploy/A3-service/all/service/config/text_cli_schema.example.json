{
  "sample_echo": {
    "id": "sample_echo",
    "name": "参数回显",
    "category": "示例领域",
    "description": "将传入的参数原样返回，用于测试服务连通性",
    "directive": "指令:示例领域;回显",
    "parameters": [
      {
        "name": "text",
        "type": "string",
        "examples": [
          "hello"
        ]
      }
    ],
    "prompt_template": "指令:示例领域;回显,{text}",
    "trigger_keywords": [
      "回显",
      "echo",
      "测试"
    ],
    "response_type": "text",
    "response_example": {
      "rst_types": "text",
      "rst_data": {
        "text": "回显结果: hello"
      }
    }
  },
  "sample_greet": {
