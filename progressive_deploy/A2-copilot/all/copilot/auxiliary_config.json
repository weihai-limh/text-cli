{
  "_comment": "text-cli-copilot config — see text-cli-copilot_programme_CN.md §5",
  "server": {
    "host": "127.0.0.1",
    "port": 20260,
    "token": null
  },
  "security": {
    "path_whitelist": [
      "${TEXT_CLI_HOME}/",
      "${TEXT_CLI_HOME}/workspace/",
      "${HOME}/"
    ],
    "operations": {
      "file;write": {
        "level": "write",
        "path_check": true,
        "aliases": [
          "file;write",
          "文件;写入"
        ],
        "description": "写入内容到本地文件（自动创建父目录）",
        "description_en": "Write content to local file (auto-create parent dirs)",
        "parameters": [
          "文件路径",
          "内容"
        ],
        "parameters_en": [
          "file_path",
          "content"
        ],
        "returns": "rst_data.text = write confirmation + bytes, rst_data.size = bytes"
      },
      "file;move": {
        "level": "write",
        "path_check": true,
        "aliases": [
          "file;move",
          "文件;移动"
        ],
        "description": "移动/重命名文件或目录（同目录=重命名，跨目录=移动）",
        "description_en": "Move/rename file or directory (same dir=rename, cross dir=move)",
        "parameters": [
          "源路径",
          "目标路径"
        ],
        "parameters_en": [
          "src_path",
          "dst_path"
        ],
        "returns": "rst_data.text = move confirmation, rst_data.from_path, rst_data.to_path"
      },
      "git;push": {
        "level": "push",
        "allowed_branches": [
          "feat/*",
          "fix/*",
          "main",
          "master"
        ],
        "aliases": [
          "git;push",
          "Git;推送"
        ],
        "description": "推送本地提交到远程仓库（HTTPS/SSH 自动选择）",
        "description_en": "Push local commits to remote (HTTPS/SSH auto)",
        "parameters": [
          "分支名"
        ],
        "parameters_en": [
          "branch_name"
        ],
        "returns": "rst_data.text = push result, rst_data.auth_mode = https|ssh"
      },
      "email;send": {
        "level": "send",
        "aliases": [
          "email;send",
          "mail;send",
          "邮件;发送"
        ],
        "description": "通过预配置 SMTP 发送邮件（支持附件）",
        "description_en": "Send email via pre-configured SMTP (with attachment support)",
        "parameters": [
          "收件人",
          "主题",
          "正文",
          "附件路径(可选)"
        ],
        "parameters_en": [
          "recipient",
          "subject",
          "body",
          "attachment_path(optional)"
        ],
        "returns": "rst_data.text = send status, rst_data.subject, rst_data.from_addr"
      },
      "ai;messages": {
        "level": "read",
        "enabled": false,
        "_comment": "2026-05-09 temporarily disabled — push mode can write arbitrary JSON, key leak risk",
        "aliases": [
          "ai;messages",
          "AI协作;消息"
        ],
        "description": "读取/推送 AI 协作者消息。读取=条数(默认1)，推送=推送,消息JSON (已禁用)",
        "description_en": "Read/push AI collaborator messages. DISABLED.",
        "parameters": [
          "条数(默认1) 或 '推送',消息JSON"
        ],
        "parameters_en": [
          "count(default 1) or '推送',message_json"
        ],
        "returns": "rst_data.text = message content list"
      },
      "key;register": {
        "level": "write",
        "sensitive": true,
        "log_policy": "no_body",
        "aliases": [
          "key;register",
          "密钥;注册"
        ],
        "description": "注册密钥 → ⤴ delegated 到 service",
        "description_en": "Register key → ⤴ delegated to service",
        "parameters": [
          "服务名",
          "凭据值1",
          "凭据值2(可选)",
          "密钥类型"
        ],
        "parameters_en": [
          "service_name",
          "value1",
          "value2(optional)",
          "key_type"
        ],
        "returns": "rst_data.text = delegated confirmation"
      },
      "key;revoke": {
        "level": "write",
        "sensitive": true,
        "aliases": [
          "key;revoke",
          "密钥;撤销"
        ],
        "description": "撤销密钥 → ⤴ delegated 到 service",
        "description_en": "Revoke key → ⤴ delegated to service",
        "parameters": [
          "服务名"
        ],
        "parameters_en": [
          "service_name"
        ],
        "returns": "rst_data.text = delegated confirmation"
      },
      "key;list": {
        "level": "read",
        "sensitive": true,
        "aliases": [
          "key;list",
          "密钥;列表"
        ],
        "description": "列出密钥 → ⤴ delegated 到 service",
        "description_en": "List keys → ⤴ delegated to service",
        "parameters": [],
        "parameters_en": [],
        "returns": "rst_data.text = delegated, rst_data.count, rst_data.keys"
      },
      "key;get": {
        "level": "read",
        "sensitive": true,
        "log_policy": "no_body",
        "aliases": [
          "key;get",
          "密钥;获取"
        ],
        "description": "获取密钥值。路由: key_routing.json → env 直取 或 ⤴ delegated",
        "description_en": "Get key value. Routed: key_routing.json → env direct or ⤴ delegated",
        "parameters": [
          "服务名"
        ],
        "parameters_en": [
          "service_name"
        ],
        "returns": "rst_data.value (env), or delegated to service"
      },
      "key;quota-track": {
        "level": "write",
        "aliases": [
          "key;quota-track",
          "密钥;配额追踪"
        ],
        "description": "设置/清除配额追踪 → ⤴ delegated 到 service",
        "description_en": "Set/clear quota tracking → ⤴ delegated to service",
        "parameters": [
          "服务名",
          "追踪目标(可选,多个)"
        ],
        "parameters_en": [
          "service_name",
          "targets(optional,multiple)"
        ],
        "returns": "rst_data.text = delegated confirmation"
      },
      "ai;json;replace": {
        "level": "write",
        "aliases": [
          "ai;json;replace",
          "AI:json;replace",
          "json;replace",
          "json;替换"
        ],
        "description": "替换 JSON 中指定路径的值。纯机械操作，零 AI。文件路径会写回磁盘。",
        "description_en": "Replace value at JSON path. Pure mechanical, zero AI. File paths are written back.",
        "parameters": [
          "JSON源(文件路径或内联JSON)",
          "JSONPath(如$.key.sub)",
          "新值"
        ],
        "parameters_en": [
          "source",
          "path",
          "new_value"
        ],
        "returns": "rst_data.path, rst_data.old, rst_data.new, rst_data.wrote_to"
      },
      "text-cli;co-install": {
        "level": "write",
        "handler": "_handle_text_cli_co_install",
        "aliases": [
          "text-cli;co-install",
          "copilot;安装"
        ],
        "description": "安装 copilot 本地操作包到 packages/ 目录。",
        "description_en": "Install a copilot local-operation package to packages/.",
        "parameters": [
          "包名",
          "--force(可选)"
        ],
        "parameters_en": [
          "package_name",
          "--force(optional)"
        ],
        "returns": "rst_data.text = install result + package info"
      },
      "text-cli;co-uninstall": {
        "level": "write",
        "handler": "_handle_text_cli_co_uninstall",
        "aliases": [
          "text-cli;co-uninstall",
          "copilot;卸载"
        ],
        "description": "卸除已安装的 copilot 本地操作包。",
        "description_en": "Uninstall a copilot local-operation package.",
        "parameters": [
          "包名"
        ],
        "parameters_en": [
          "package_name"
        ],
        "returns": "rst_data.text = uninstall confirmation"
      },
      "text-cli;co-list": {
        "level": "read",
        "handler": "_handle_text_cli_co_list",
        "aliases": [
          "text-cli;co-list",
          "copilot;已安装"
        ],
        "description": "列出 copilot 已安装的本地操作包。",
        "description_en": "List installed copilot local-operation packages.",
        "parameters": [],
        "parameters_en": [],
        "returns": "rst_data.text = package list"
      }
    }
  },
  "credentials": {
    "git;push": {
      "value": "${GIT_TOKEN}",
      "remote_url": null
    },
    "email;send": {
      "value": "${SMTP_PASSWORD}",
      "smtp_host": "smtp.mxhichina.com",
      "smtp_port": 465,
      "smtp_user": "${SMTP_USER}",
      "from_email": "${SMTP_FROM}"
    }
  },
  "git": {
    "workdir": "${TEXT_CLI_HOME}/workspace/",
    "remote_name": "origin"
  },
  "endpoint_info": {
    "name": "指令辅助服务器",
    "description": "本地文件、Git、邮件操作代理",
    "version": "1.0.0"
  }
}