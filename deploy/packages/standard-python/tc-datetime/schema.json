{
  "id": "tc-datetime",
  "type": "native",
  "version": "0.1.1",
  "license": "MIT",
  "name": "TC DateTime Calculator",
  "name_zh": "日期时间计算",
  "runtime": "python",
  "category": "基础设施",
  "locales": [
    "zh",
    "en"
  ],
  "description": "Date/time calculator for path pipelines. Zero external dependencies, stdlib datetime only. now/offset/between/weekday/range/format.",
  "description_zh": "路径管道用日期时间计算工具。零外部依赖，纯 stdlib datetime。now/offset/between/weekday/range/format。",
  "requires": {},
  "directives": [
    {
      "domain": "tc-datetime",
      "domain_zh": "日期时间",
      "action": "now",
      "action_zh": "现在",
      "usage": "tc-datetime;now[,<format>]",
      "usage_zh": "日期时间;现在[,<格式>]",
      "description": "Get current date/time. format: iso(default)/date/timestamp/human.",
      "description_zh": "获取当前日期时间。格式：iso(默认)/date/timestamp/human。",
      "params": [
        "format"
      ],
      "params_desc": {
        "format": "iso/date/timestamp/human (default: iso)"
      },
      "outputs": [
        "date",
        "timestamp",
        "timezone"
      ]
    },
    {
      "domain": "tc-datetime",
      "domain_zh": "日期时间",
      "action": "offset",
      "action_zh": "偏移",
      "usage": "tc-datetime;offset,<date>,<JSON>",
      "usage_zh": "日期时间;偏移,<日期>,<JSON>",
      "description": "Add/subtract time from a date. JSON: {days, weeks, months, years, hours, minutes}.",
      "description_zh": "日期加减偏移。JSON参数：{days, weeks, months, years, hours, minutes}。",
      "params": [
        "date",
        "offset_json"
      ],
      "params_desc": {
        "date": "ISO date string or Unix timestamp",
        "offset_json": "JSON: {days?, weeks?, months?, years?, hours?, minutes?}"
      },
      "outputs": [
        "result"
      ]
    },
    {
      "domain": "tc-datetime",
      "domain_zh": "日期时间",
      "action": "between",
      "action_zh": "间距",
      "usage": "tc-datetime;between,<date_a>,<date_b>,<unit>",
      "usage_zh": "日期时间;间距,<日期A>,<日期B>,<单位>",
      "description": "Calculate duration between two dates. unit: days/hours/minutes/seconds/human.",
      "description_zh": "计算两个日期间的时长。单位：days/hours/minutes/seconds/human。",
      "params": [
        "date_a",
        "date_b",
        "unit"
      ],
      "params_desc": {
        "date_a": "First date (ISO or timestamp)",
        "date_b": "Second date (ISO or timestamp)",
        "unit": "days/hours/minutes/seconds/human"
      },
      "outputs": [
        "result"
      ]
    },
    {
      "domain": "tc-datetime",
      "domain_zh": "日期时间",
      "action": "weekday",
      "action_zh": "星期几",
      "usage": "tc-datetime;weekday,<date>",
      "usage_zh": "日期时间;星期几,<日期>",
      "description": "Get weekday of a date. Returns Chinese name, English name, and numeric (Mon=0).",
      "description_zh": "获取日期对应的星期几。返回中文名、英文名和数字（Mon=0）。",
      "params": [
        "date"
      ],
      "params_desc": {
        "date": "ISO date string or Unix timestamp"
      },
      "outputs": [
        "date",
        "weekday",
        "weekday_en",
        "weekday_num",
        "is_weekend"
      ]
    },
    {
      "domain": "tc-datetime",
      "domain_zh": "日期时间",
      "action": "range",
      "action_zh": "序列",
      "usage": "tc-datetime;range,<start_date>,<JSON>",
      "usage_zh": "日期时间;序列,<起始日期>,<JSON>",
      "description": "Generate a date sequence. JSON: {days?/weeks?/until?/step?}.",
      "description_zh": "生成日期序列。JSON参数：{days?/weeks?/until?/step?}。",
      "params": [
        "start_date",
        "range_json"
      ],
      "params_desc": {
        "start_date": "Start date (ISO or timestamp)",
        "range_json": "JSON: {days?, weeks?, until?, step?}"
      },
      "outputs": [
        "result"
      ]
    },
    {
      "domain": "tc-datetime",
      "domain_zh": "日期时间",
      "action": "format",
      "action_zh": "格式化",
      "usage": "tc-datetime;format,<date_or_ts>,<to_format>",
      "usage_zh": "日期时间;格式化,<日期或时间戳>,<目标格式>",
      "description": "Convert between date/time formats. to_format: iso/date/timestamp/human/human_en.",
      "description_zh": "日期格式互转。目标格式：iso/date/timestamp/human/human_en。",
      "params": [
        "date_or_ts",
        "to_format"
      ],
      "params_desc": {
        "date_or_ts": "ISO date or Unix timestamp",
        "to_format": "iso/date/timestamp/human/human_en"
      },
      "outputs": [
        "result"
      ]
    }
  ],
  "trust": "community"
}
