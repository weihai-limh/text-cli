{
  "name": "dsh-tc-bridge",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "dsh 的能力缝插件：把 tc 指令生态（远程端点 + 本地 textcli-core）与 dsh 自身/mcp tool 统一为一个调度平面，对 dsh agent 暴露 call_tc / wait_tc / run_tc_js / tool_avatar / find_tc 五个闭集工具。",
  "workspaces": [],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "textcli-core": "file:../../npm/textcli-core"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
