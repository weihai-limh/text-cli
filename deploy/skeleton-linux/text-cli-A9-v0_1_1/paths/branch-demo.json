{
  "id": "branch-demo",
  "name": "Branch Demo",
  "type": "pipeline",
  "version": "0.1.0",
  "mode": "toolchain",
  "description": "Conditional branch: step2 executes only when step1 result matches.",
  "input_schema": {"type": "object", "properties": {}},
  "steps": [
    {"id": "calc", "instruction": "hello;world,hi", "output_as": "val"},
    {"id": "big", "instruction": "hello;world,branch-yes",
     "output_as": "big_val",
     "if": {"step": "val", "field": "result", "equals": "Hello!hi!"}}
  ]
}
