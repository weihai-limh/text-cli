{
  "id": "tc-json",
  "name": "TC JSON Structure Operations",
  "name_zh": "tc-json 结构操作",
  "version": "0.1.2",
  "license": "MIT",
  "type": "native",
  "runtime": "python",
  "entry": "handler.py",
  "category": "数据处理",
  "locales": [
    "zh",
    "en"
  ],
  "description": "Pure-stdlib JSON structure primitives: validate, pretty-print, list keys, shallow merge, dot-path parse. Zero dependencies.",
  "description_zh": "纯 stdlib JSON 结构原语：校验、美化、列出键、浅合并、点路径解析。零依赖。",
  "requires": {},
  "directives": [
    {
      "domain": "tc-json",
      "domain_zh": "tc-json",
      "action": "validate",
      "action_zh": "校验",
      "usage": "tc-json;validate,'<json>'",
      "usage_zh": "tc-json;校验,'<json>'",
      "description": "Validate JSON string. Returns valid=true/false with error detail.",
      "description_zh": "校验 JSON 字符串合法性。返回 valid=true/false 含错误详情。",
      "params": [
        "json_string"
      ],
      "params_desc": {
        "json_string": "JSON string to validate"
      },
      "outputs": [
        "valid",
        "error"
      ]
    },
    {
      "domain": "tc-json",
      "domain_zh": "tc-json",
      "action": "pretty",
      "action_zh": "美化",
      "usage": "tc-json;pretty,'<json>'",
      "usage_zh": "tc-json;美化,'<json>'",
      "description": "Pretty-print JSON with 2-space indent.",
      "description_zh": "以 2 空格缩进美化 JSON。",
      "params": [
        "json_string"
      ],
      "params_desc": {
        "json_string": "JSON string to format"
      },
      "outputs": [
        "result"
      ]
    },
    {
      "domain": "tc-json",
      "domain_zh": "tc-json",
      "action": "keys",
      "action_zh": "所有键",
      "usage": "tc-json;keys,'<json>'",
      "usage_zh": "tc-json;所有键,'<json>'",
      "description": "List all top-level keys of a JSON object.",
      "description_zh": "列出 JSON 对象的所有顶层键。",
      "params": [
        "json_string"
      ],
      "params_desc": {
        "json_string": "JSON object string"
      },
      "outputs": [
        "keys",
        "count"
      ]
    },
    {
      "domain": "tc-json",
      "domain_zh": "tc-json",
      "action": "merge",
      "action_zh": "合并",
      "usage": "tc-json;merge,'<json1>','<json2>'",
      "usage_zh": "tc-json;合并,'<json1>','<json2>'",
      "description": "Shallow-merge two JSON objects. Keys in json2 override json1.",
      "description_zh": "浅合并两个 JSON 对象。json2 的键覆盖 json1。",
      "params": [
        "json1",
        "json2"
      ],
      "params_desc": {
        "json1": "Base JSON object",
        "json2": "Override JSON object"
      },
      "outputs": [
        "reason"
      ]
    },
    {
      "domain": "tc-json",
      "domain_zh": "tc-json",
      "action": "parse",
      "action_zh": "解析",
      "usage": "tc-json;parse,'<json>','<dot-path>'",
      "usage_zh": "tc-json;解析,'<json>','<点路径>'",
      "description": "Extract a value from JSON by dot-path. Supports array indices (e.g. a.b.0.c).",
      "description_zh": "按点路径从 JSON 中提取值。支持数组索引 (如 a.b.0.c)。",
      "params": [
        "json_string",
        "dot_path"
      ],
      "params_desc": {
        "json_string": "JSON string to parse",
        "dot_path": "Dot-separated path, e.g. 'address.city' or 'results.0.name'"
      },
      "outputs": [
        "value"
      ]
    },
    {
      "domain": "tc-json",
      "domain_zh": "tc-json",
      "action": "set",
      "action_zh": "设置",
      "usage": "tc-json;set,'<json>','<dot-path>','<value>'",
      "usage_zh": "tc-json;设置,'<json>','<点路径>','<值>'",
      "description": "Set a value at dot-path in JSON. Creates intermediate dicts if needed.",
      "description_zh": "在 JSON 中按点路径设置值。中间路径不存在时自动创建对象。",
      "params": [
        "json_string",
        "dot_path",
        "value"
      ],
      "params_desc": {
        "json_string": "JSON object string",
        "dot_path": "Dot-path to set, e.g. 'config.timeout'",
        "value": "JSON value to set (string, number, object, or array)"
      },
      "outputs": [
        "value"
      ]
    },
    {
      "domain": "tc-json",
      "domain_zh": "tc-json",
      "action": "del",
      "action_zh": "删除",
      "usage": "tc-json;del,'<json>','<dot-path>'",
      "usage_zh": "tc-json;删除,'<json>','<点路径>'",
      "description": "Delete a key at dot-path from JSON. Returns the modified object.",
      "description_zh": "按点路径从 JSON 中删除一个键。返回修改后的对象。",
      "params": [
        "json_string",
        "dot_path"
      ],
      "params_desc": {
        "json_string": "JSON object string",
        "dot_path": "Dot-path to delete, e.g. 'config.debug'"
      },
      "outputs": [
        "reason"
      ]
    },
    {
      "domain": "tc-json",
      "domain_zh": "tc-json",
      "action": "pick",
      "action_zh": "提取",
      "usage": "tc-json;pick,'<json>','<path_array_json>'",
      "usage_zh": "tc-json;提取,'<json>','<路径数组JSON>'",
      "description": "Extract selected dot-paths from JSON into a new object.",
      "description_zh": "从 JSON 中提取指定点路径生成新对象。",
      "params": [
        "json_string",
        "path_array"
      ],
      "params_desc": {
        "json_string": "JSON object string",
        "path_array": "JSON array of dot-paths, e.g. [\"name\",\"address.city\"]"
      },
      "outputs": [
        "result",
        "count"
      ]
    },
    {
      "domain": "tc-json",
      "domain_zh": "tc-json",
      "action": "split",
      "action_zh": "分块",
      "usage": "tc-json;split,'<text>'[,<size>][,<overlap>]",
      "usage_zh": "tc-json;分块,'<文本>'[,<每块字数>][,<重叠字数>]",
      "description": "Split long text into JSONL chunks at sentence boundaries. Returns path to chunks file.",
      "description_zh": "将长文本按句子边界切分为 JSONL 块。返回分块文件路径。",
      "params": [
        "text",
        "size",
        "overlap"
      ],
      "params_desc": {
        "text": "Text to split",
        "size": "Target chars per chunk (default 5000)",
        "overlap": "Overlap chars between chunks (default 0)"
      },
      "outputs": [
        "result",
        "count"
      ]
    },
    {
      "domain": "tc-json",
      "domain_zh": "tc-json",
      "action": "join",
      "action_zh": "拼接",
      "usage": "tc-json;join,'<path>'[,<field>]",
      "usage_zh": "tc-json;拼接,'<路径>'[,<字段名>]",
      "description": "Join JSONL chunks from a file back into text. Returns path to merged text file.",
      "description_zh": "将 JSONL 分块文件拼接回文本。返回合并后文件路径。",
      "params": [
        "path",
        "field"
      ],
      "params_desc": {
        "path": "Path to JSONL file",
        "field": "Field to join (default 'text')"
      },
      "outputs": [
        "reason"
      ]
    }
  ],
  "trust": "community"
}
