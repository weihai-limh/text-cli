    {
      "domain": "vikunja",
      "domain_zh": "Vikunja",
      "action": "get-user",
      "action_zh": "获取用户",
      "usage": "vikunja;get-user,<user_id>",
      "usage_zh": "vikunja;get-user,<用户ID>",
      "description": "Get user details by ID.",
      "description_zh": "根据 ID 获取用户详情。",
      "params": [
        "user_id"
      ],
      "params_desc": {
        "user_id": "User ID (integer)"
      },
      "outputs": [
        "status",
        "email",
        "id",
        "name",
        "username",
        "reason"
      ]
