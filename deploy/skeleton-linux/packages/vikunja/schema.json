{
  "id": "vikunja",
  "type": "native",
  "version": "0.1.1",
  "license": "MIT",
  "name": "Vikunja Task Management",
  "name_zh": "Vikunja 任务管理",
  "runtime": "python",
  "description": "Self-hosted task management via Vikunja API. Create, update, complete tasks, organize into projects, use labels, and manage task relations for path pipeline routing.",
  "description_zh": "通过 Vikunja API 管理自托管任务。创建、更新、完成任务，组织到项目，使用标签，管理任务关系以供路径管道路由。",
  "category": "协作",
  "locales": [
    "en",
    "zh"
  ],
  "entry": "handler.py",
  "requires": {
    "pip": [
      "requests"
    ],
    "modules": [
      "text_cli_modules/key/"
    ]
  },
  "credentials": [
    {
      "name": "vikunja",
      "description_en": "Vikunja API Bearer token for self-hosted instance",
      "description_zh": "Vikunja 自托管实例的 API Bearer Token",
      "storage": "a6_key_registry",
      "register_cmd": "AI:key;register,vikunja,<token>,api_key"
    }
  ],
  "directives": [
    {
      "domain": "vikunja",
      "domain_zh": "Vikunja",
      "action": "list-tasks",
      "action_zh": "列出任务",
      "usage": "vikunja;list-tasks[,<JSON>]",
      "usage_zh": "vikunja;list-tasks[,<JSON>]",
      "description": "List tasks with optional filter, sort, and pagination.",
      "description_zh": "列出任务，支持筛选、排序和分页。",
      "params": [
        "JSON"
      ],
      "params_desc": {
        "JSON": "Optional: {\"filter_by\":[...],\"sort_by\":[...],\"page\":1,\"per_page\":50}"
      },
      "outputs": [
        "status",
        "count",
        "tasks",
        "total",
        "reason"
      ]
    },
    {
      "domain": "vikunja",
      "domain_zh": "Vikunja",
      "action": "create-task",
      "action_zh": "创建任务",
      "usage": "vikunja;create-task,<JSON>",
      "usage_zh": "vikunja;create-task,<JSON>",
      "description": "Create a new task. JSON: {title, description?, priority?, due_date?, project_id?, labels?}.",
      "description_zh": "创建新任务。JSON: {title, description?, priority?, due_date?, project_id?, labels?}。",
      "params": [
        "JSON"
      ],
      "params_desc": {
        "JSON": "Task data: {title: required, description, priority 0-5, due_date YYYY-MM-DD, project_id, labels: [id,...]}"
      },
      "outputs": [
        "status",
        "description",
        "done",
        "due_date",
        "id",
        "labels",
        "priority",
        "project_id",
        "title",
        "reason"
      ]
    },
    {
      "domain": "vikunja",
      "domain_zh": "Vikunja",
      "action": "get-task",
      "action_zh": "获取任务",
      "usage": "vikunja;get-task,<task_id>",
      "usage_zh": "vikunja;get-task,<任务ID>",
      "description": "Get task details by ID.",
      "description_zh": "根据 ID 获取任务详情。",
      "params": [
        "task_id"
      ],
      "params_desc": {
        "task_id": "Task ID (integer)"
      },
      "outputs": [
        "status",
        "description",
        "done",
        "due_date",
        "id",
        "labels",
        "priority",
        "project_id",
        "title",
        "reason"
      ]
    },
    {
      "domain": "vikunja",
      "domain_zh": "Vikunja",
      "action": "update-task",
      "action_zh": "更新任务",
      "usage": "vikunja;update-task,<task_id>,<JSON>",
      "usage_zh": "vikunja;update-task,<任务ID>,<JSON>",
      "description": "Update task fields by ID. JSON: any subset of {title, description, priority, due_date, project_id, labels, done}.",
      "description_zh": "根据 ID 更新任务字段。JSON: {title, description, priority, due_date, project_id, labels, done} 任意子集。",
      "params": [
        "task_id",
        "JSON"
      ],
      "params_desc": {
        "task_id": "Task ID (integer)",
        "JSON": "Fields to update"
      },
      "outputs": [
        "status",
        "description",
        "done",
        "due_date",
        "id",
        "labels",
        "priority",
        "project_id",
        "title",
        "reason"
      ]
    },
    {
      "domain": "vikunja",
      "domain_zh": "Vikunja",
      "action": "delete-task",
      "action_zh": "删除任务",
      "usage": "vikunja;delete-task,<task_id>",
      "usage_zh": "vikunja;delete-task,<任务ID>",
      "description": "Delete task by ID.",
      "description_zh": "根据 ID 删除任务。",
      "params": [
        "task_id"
      ],
      "params_desc": {
        "task_id": "Task ID (integer)"
      },
      "outputs": [
        "status",
        "deleted",
        "id",
        "reason"
      ]
    },
    {
      "domain": "vikunja",
      "domain_zh": "Vikunja",
      "action": "done",
      "action_zh": "完成任务",
      "usage": "vikunja;done,<task_id>",
      "usage_zh": "vikunja;done,<任务ID>",
      "description": "Mark task as done.",
      "description_zh": "标记任务为完成。",
      "params": [
        "task_id"
      ],
      "params_desc": {
        "task_id": "Task ID (integer)"
      },
      "outputs": [
        "status",
        "done",
        "id",
        "reason"
      ]
    },
    {
      "domain": "vikunja",
      "domain_zh": "Vikunja",
      "action": "undone",
      "action_zh": "取消完成",
      "usage": "vikunja;undone,<task_id>",
      "usage_zh": "vikunja;undone,<任务ID>",
      "description": "Mark task as not done.",
      "description_zh": "标记任务为未完成。",
      "params": [
        "task_id"
      ],
      "params_desc": {
        "task_id": "Task ID (integer)"
      },
      "outputs": [
        "status",
        "done",
        "id",
        "reason"
      ]
    },
    {
      "domain": "vikunja",
      "domain_zh": "Vikunja",
      "action": "assignees",
      "action_zh": "任务参与人",
      "usage": "vikunja;assignees,<task_id>",
      "usage_zh": "vikunja;assignees,<任务ID>",
      "description": "Get users assigned to task.",
      "description_zh": "获取任务分配的用户列表。",
      "params": [
        "task_id"
      ],
      "params_desc": {
        "task_id": "Task ID (integer)"
      },
      "outputs": [
        "status",
        "assignees",
        "count",
        "task_id",
        "reason"
      ]
    },
    {
      "domain": "vikunja",
      "domain_zh": "Vikunja",
      "action": "assign",
      "action_zh": "分配用户",
      "usage": "vikunja;assign,<task_id>,<user_id>",
      "usage_zh": "vikunja;assign,<任务ID>,<用户ID>",
      "description": "Assign a user to task.",
      "description_zh": "分配用户到任务。",
      "params": [
        "task_id",
        "user_id"
      ],
      "params_desc": {
        "task_id": "Task ID (integer)",
        "user_id": "User ID (integer)"
      },
      "outputs": [
        "status",
        "assigned",
        "task_id",
        "user_id",
        "reason"
      ]
    },
    {
      "domain": "vikunja",
      "domain_zh": "Vikunja",
      "action": "list-projects",
      "action_zh": "列出项目",
      "usage": "vikunja;list-projects[,<JSON>]",
      "usage_zh": "vikunja;list-projects[,<JSON>]",
      "description": "List projects with optional filter and pagination.",
      "description_zh": "列出项目，支持筛选和分页。",
      "params": [
        "JSON"
      ],
      "params_desc": {
        "JSON": "Optional: {\"filter_by\":[...],\"page\":1,\"per_page\":50}"
      },
      "outputs": [
        "status",
        "count",
        "projects",
        "reason"
      ]
    },
    {
      "domain": "vikunja",
      "domain_zh": "Vikunja",
      "action": "create-project",
      "action_zh": "创建项目",
      "usage": "vikunja;create-project,<JSON>",
      "usage_zh": "vikunja;create-project,<JSON>",
      "description": "Create a new project. JSON: {title, description?, parent_project_id?}.",
      "description_zh": "创建新项目。JSON: {title, description?, parent_project_id?}。",
      "params": [
        "JSON"
      ],
      "params_desc": {
        "JSON": "Project data: {title: required, description?, parent_project_id?}"
      },
      "outputs": [
        "status",
        "description",
        "id",
        "parent_project_id",
        "title",
        "reason"
      ]
    },
    {
      "domain": "vikunja",
      "domain_zh": "Vikunja",
      "action": "get-project",
      "action_zh": "获取项目",
      "usage": "vikunja;get-project,<project_id>",
      "usage_zh": "vikunja;get-project,<项目ID>",
      "description": "Get project details by ID.",
      "description_zh": "根据 ID 获取项目详情。",
      "params": [
        "project_id"
      ],
      "params_desc": {
        "project_id": "Project ID (integer)"
      },
      "outputs": [
        "status",
        "description",
        "id",
        "parent_project_id",
        "title",
        "reason"
      ]
    },
    {
      "domain": "vikunja",
      "domain_zh": "Vikunja",
      "action": "update-project",
      "action_zh": "更新项目",
      "usage": "vikunja;update-project,<project_id>,<JSON>",
      "usage_zh": "vikunja;update-project,<项目ID>,<JSON>",
      "description": "Update project fields by ID. JSON: any subset of {title, description, parent_project_id}.",
      "description_zh": "根据 ID 更新项目字段。JSON: {title, description, parent_project_id} 任意子集。",
      "params": [
        "project_id",
        "JSON"
      ],
      "params_desc": {
        "project_id": "Project ID (integer)",
        "JSON": "Fields to update"
      },
      "outputs": [
        "status",
        "description",
        "id",
        "parent_project_id",
        "title",
        "reason"
      ]
    },
    {
      "domain": "vikunja",
      "domain_zh": "Vikunja",
      "action": "delete-project",
      "action_zh": "删除项目",
      "usage": "vikunja;delete-project,<project_id>",
      "usage_zh": "vikunja;delete-project,<项目ID>",
      "description": "Delete project by ID.",
      "description_zh": "根据 ID 删除项目。",
      "params": [
        "project_id"
      ],
      "params_desc": {
        "project_id": "Project ID (integer)"
      },
      "outputs": [
        "status",
        "deleted",
        "id",
        "reason"
      ]
    },
    {
      "domain": "vikunja",
      "domain_zh": "Vikunja",
      "action": "project-tasks",
      "action_zh": "项目任务",
      "usage": "vikunja;project-tasks,<project_id>[,<JSON>]",
      "usage_zh": "vikunja;project-tasks,<项目ID>[,<JSON>]",
      "description": "List tasks within a project, with optional filter and pagination.",
      "description_zh": "列出项目下的任务，支持筛选和分页。",
      "params": [
        "project_id",
        "JSON"
      ],
      "params_desc": {
        "project_id": "Project ID (integer)",
        "JSON": "Optional: {\"filter_by\":[...],\"page\":1,\"per_page\":50}"
      },
      "outputs": [
        "status",
        "count",
        "project_id",
        "tasks",
        "reason"
      ]
    },
    {
      "domain": "vikunja",
      "domain_zh": "Vikunja",
      "action": "list-labels",
      "action_zh": "列出标签",
      "usage": "vikunja;list-labels[,<JSON>]",
      "usage_zh": "vikunja;list-labels[,<JSON>]",
      "description": "List labels with optional filter and pagination.",
      "description_zh": "列出标签，支持筛选和分页。",
      "params": [
        "JSON"
      ],
      "params_desc": {
        "JSON": "Optional: {\"filter_by\":[...],\"page\":1,\"per_page\":50}"
      },
      "outputs": [
        "status",
        "count",
        "labels",
        "reason"
      ]
    },
    {
      "domain": "vikunja",
      "domain_zh": "Vikunja",
      "action": "create-label",
      "action_zh": "创建标签",
      "usage": "vikunja;create-label,<JSON>",
      "usage_zh": "vikunja;create-label,<JSON>",
      "description": "Create a new label. JSON: {title, description?, color?}.",
      "description_zh": "创建新标签。JSON: {title, description?, color?}。",
      "params": [
        "JSON"
      ],
      "params_desc": {
        "JSON": "Label data: {title: required, description?, color? hex}"
      },
      "outputs": [
        "status",
        "color",
        "description",
        "id",
        "title",
        "reason"
      ]
    },
    {
      "domain": "vikunja",
      "domain_zh": "Vikunja",
      "action": "get-label",
      "action_zh": "获取标签",
      "usage": "vikunja;get-label,<label_id>",
      "usage_zh": "vikunja;get-label,<标签ID>",
      "description": "Get label details by ID.",
      "description_zh": "根据 ID 获取标签详情。",
      "params": [
        "label_id"
      ],
      "params_desc": {
        "label_id": "Label ID (integer)"
      },
      "outputs": [
        "status",
        "color",
        "description",
        "id",
        "title",
        "reason"
      ]
    },
    {
      "domain": "vikunja",
      "domain_zh": "Vikunja",
      "action": "update-label",
      "action_zh": "更新标签",
      "usage": "vikunja;update-label,<label_id>,<JSON>",
      "usage_zh": "vikunja;update-label,<标签ID>,<JSON>",
      "description": "Update label fields by ID. JSON: any subset of {title, description, color}.",
      "description_zh": "根据 ID 更新标签字段。JSON: {title, description, color} 任意子集。",
      "params": [
        "label_id",
        "JSON"
      ],
      "params_desc": {
        "label_id": "Label ID (integer)",
        "JSON": "Fields to update"
      },
      "outputs": [
        "status",
        "color",
        "description",
        "id",
        "title",
        "reason"
      ]
    },
    {
      "domain": "vikunja",
      "domain_zh": "Vikunja",
      "action": "delete-label",
      "action_zh": "删除标签",
      "usage": "vikunja;delete-label,<label_id>",
      "usage_zh": "vikunja;delete-label,<标签ID>",
      "description": "Delete label by ID.",
      "description_zh": "根据 ID 删除标签。",
      "params": [
        "label_id"
      ],
      "params_desc": {
        "label_id": "Label ID (integer)"
      },
      "outputs": [
        "status",
        "deleted",
        "id",
        "reason"
      ]
    },
    {
      "domain": "vikunja",
      "domain_zh": "Vikunja",
      "action": "list-relations",
      "action_zh": "列出任务关系",
      "usage": "vikunja;list-relations,<task_id>",
      "usage_zh": "vikunja;list-relations,<任务ID>",
      "description": "List all relations for a task (blocking, blocked, related, etc).",
      "description_zh": "列出任务的所有关系（阻塞、被阻塞、关联等）。",
      "params": [
        "task_id"
      ],
      "params_desc": {
        "task_id": "Task ID (integer)"
      },
      "outputs": [
        "status",
        "count",
        "relations",
        "task_id",
        "reason"
      ]
    },
    {
      "domain": "vikunja",
      "domain_zh": "Vikunja",
      "action": "create-relation",
      "action_zh": "创建任务关系",
      "usage": "vikunja;create-relation,<task_id>,<JSON>",
      "usage_zh": "vikunja;create-relation,<任务ID>,<JSON>",
      "description": "Create a relation between tasks. JSON: {other_task_id, relation_kind}. Kind: blocking/blocked/related/duplicate/parenttask/subtask.",
      "description_zh": "创建任务间关系。JSON: {other_task_id, relation_kind}。类型: blocking/blocked/related/duplicate/parenttask/subtask。",
      "params": [
        "task_id",
        "JSON"
      ],
      "params_desc": {
        "task_id": "Task ID (integer)",
        "JSON": "Relation data: {other_task_id: required, relation_kind: required}"
      },
      "outputs": [
        "status",
        "created_by",
        "other_task_id",
        "relation_kind",
        "task_id",
        "reason"
      ]
    },
    {
      "domain": "vikunja",
      "domain_zh": "Vikunja",
      "action": "delete-relation",
      "action_zh": "删除任务关系",
      "usage": "vikunja;delete-relation,<task_id>,<JSON>",
      "usage_zh": "vikunja;delete-relation,<任务ID>,<JSON>",
      "description": "Delete a task relation by kind and other_task_id. JSON: {relation_kind, other_task_id}.",
      "description_zh": "根据关系类型和关联任务 ID 删除任务关系。JSON: {relation_kind, other_task_id}。",
      "params": [
        "task_id",
        "JSON"
      ],
      "params_desc": {
        "task_id": "Task ID (integer)",
        "JSON": "Relation identification: {relation_kind: required, other_task_id: required}"
      },
      "outputs": [
        "status",
        "deleted",
        "other_task_id",
        "relation_kind",
        "task_id",
        "reason"
      ]
    },
    {
      "domain": "vikunja",
      "domain_zh": "Vikunja",
      "action": "list-users",
      "action_zh": "列出用户",
      "usage": "vikunja;list-users",
      "usage_zh": "vikunja;list-users",
      "description": "List all users.",
      "description_zh": "列出所有用户。",
      "params": [],
