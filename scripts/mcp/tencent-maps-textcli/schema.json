  "tencent-maps_action_geocode": {
    "id": "tencent-maps_action_geocode",
    "name": "geocode（地址解析）",
    "category": "地图",
    "description": "Convert address to lat/lng;将包含省市区的地址转换为经纬度",
    "directive": "AI:map;geocode",
    "directive_zh": "AI:地图;地址解析",
    "parameters": [
      {
        "name": "address",
        "type": "string",
        "description": "地址"
      }
    ],
    "prompt_template": "AI:map;geocode,{address}",
    "trigger_keywords": [
      "地址解析",
      "经纬度",
      "坐标",
      "地理编码",
      "geocode",
      "latlng",
      "coordinates"
    ],
    "response_type": "text",
    "routing": {
      "type": "mcp",
      "backends": [
        {
          "type": "mcp",
          "server": "tencent-maps",
          "tool": "geocoder",
          "adapter": "passthrough",
          "timeout_ms": 30000
        }
      ]
    }
  },
