{
  "id": "aria2",
  "type": "native",
  "version": "0.1.1",
  "license": "MIT",
  "name": "aria2 Download Manager",
  "name_zh": "aria2 下载管理",
  "runtime": "python",
  "description": "Manage downloads via aria2 JSON-RPC API. Add HTTP/BT downloads, query progress, control tasks.",
  "description_zh": "通过 aria2 JSON-RPC API 管理下载任务。添加 HTTP/BT 下载、查询进度、控制任务。",
  "category": "工具",
  "locales": [
    "en",
    "zh"
  ],
  "entry": "handler.py",
  "requires": {
    "pip": [
      "requests"
    ],
    "modules": [
      "text_cli_modules/key/"
    ]
  },
  "credentials": [
    {
      "name": "aria2",
      "description_en": "aria2 JSON-RPC token for NAS aria2 service",
      "description_zh": "NAS 上 aria2 服务的 JSON-RPC token",
      "storage": "a6_key_registry",
      "register_cmd": "AI:key;register,aria2,<token>,api_key"
    }
  ],
  "directives": [
    {
      "domain": "aria2",
      "domain_zh": "aria2",
      "action": "add-uri",
      "action_zh": "添加下载",
      "usage": "aria2;add-uri,<JSON>",
      "usage_zh": "aria2;add-uri,<JSON>",
      "description": "Add HTTP/FTP download. JSON: {uris: [urls], options?: {out, dir}, position?}.",
      "description_zh": "添加 HTTP/FTP 下载。JSON: {uris: [URL数组], options?: {out, dir}, position?}。",
      "params": [
        "JSON"
      ],
      "params_desc": {
        "JSON": "Download data: {uris: required, options?: {out, dir}, position?}"
      },
      "outputs": [
        "status",
        "gid",
        "reason"
      ]
    },
    {
      "domain": "aria2",
      "domain_zh": "aria2",
      "action": "add-torrent",
      "action_zh": "添加种子",
      "usage": "aria2;add-torrent,<JSON>",
      "usage_zh": "aria2;add-torrent,<JSON>",
      "description": "Add BitTorrent download. JSON: {torrent_data: path/to/file, options?: {dir}}.",
      "description_zh": "添加 BT 种子下载。JSON: {torrent_data: 种子路径, options?: {dir}}。",
      "params": [
        "JSON"
      ],
      "params_desc": {
        "JSON": "Torrent data: {torrent_data: required, options?: {dir}}"
      },
      "outputs": [
        "status",
        "gid",
        "reason"
      ]
    },
    {
      "domain": "aria2",
      "domain_zh": "aria2",
      "action": "remove",
      "action_zh": "移除下载",
      "usage": "aria2;remove,<gid>",
      "usage_zh": "aria2;remove,<任务GID>",
      "description": "Remove a download by GID.",
      "description_zh": "根据 GID 移除下载任务。",
      "params": [
        "gid"
      ],
      "params_desc": {
        "gid": "Download GID (hex string)"
      },
      "outputs": [
        "status",
        "gid",
        "reason"
      ]
    },
    {
      "domain": "aria2",
      "domain_zh": "aria2",
      "action": "pause",
      "action_zh": "暂停下载",
      "usage": "aria2;pause,<gid>",
      "usage_zh": "aria2;pause,<任务GID>",
      "description": "Pause a download by GID.",
      "description_zh": "根据 GID 暂停下载。",
      "params": [
        "gid"
      ],
      "params_desc": {
        "gid": "Download GID (hex string)"
      },
      "outputs": [
        "status",
        "gid",
        "reason"
      ]
    },
    {
      "domain": "aria2",
      "domain_zh": "aria2",
      "action": "unpause",
      "action_zh": "恢复下载",
      "usage": "aria2;unpause,<gid>",
      "usage_zh": "aria2;unpause,<任务GID>",
      "description": "Resume a paused download by GID.",
      "description_zh": "根据 GID 恢复已暂停的下载。",
      "params": [
        "gid"
      ],
      "params_desc": {
        "gid": "Download GID (hex string)"
      },
      "outputs": [
        "status",
        "gid",
        "reason"
      ]
    },
    {
      "domain": "aria2",
      "domain_zh": "aria2",
      "action": "purge",
      "action_zh": "清理已完成",
      "usage": "aria2;purge",
      "usage_zh": "aria2;purge",
      "description": "Purge completed/stopped/removed downloads from the session.",
      "description_zh": "清除已完成/已停止/已移除的任务记录。",
      "params": [],
      "params_desc": {},
      "outputs": [
        "status",
        "purged",
        "reason"
      ]
    },
    {
      "domain": "aria2",
      "domain_zh": "aria2",
      "action": "status",
      "action_zh": "下载状态",
      "usage": "aria2;status,<gid>",
      "usage_zh": "aria2;status,<任务GID>",
      "description": "Get detailed status of a download by GID. Returns state, speed, progress, file info.",
      "description_zh": "根据 GID 获取下载详细状态。返回状态、速度、进度、文件信息。",
      "params": [
        "gid"
      ],
      "params_desc": {
        "gid": "Download GID (hex string)"
      },
      "outputs": [
        "status",
        "gid",
        "reason"
      ]
    },
    {
      "domain": "aria2",
      "domain_zh": "aria2",
      "action": "active",
      "action_zh": "活动任务",
      "usage": "aria2;active[,<keys>]",
      "usage_zh": "aria2;active[,<字段>]",
      "description": "List all active downloads with progress.",
      "description_zh": "列出所有活动下载及其进度。",
      "params": [
        "keys"
      ],
      "params_desc": {
        "keys": "Optional: comma-separated field names to filter response"
      },
      "outputs": [
        "status",
        "count",
        "downloads",
        "reason"
      ]
    },
    {
      "domain": "aria2",
      "domain_zh": "aria2",
      "action": "waiting",
      "action_zh": "等待队列",
      "usage": "aria2;waiting,<offset>,<num>",
      "usage_zh": "aria2;waiting,<偏移>,<数量>",
      "description": "List waiting downloads with offset/limit pagination.",
      "description_zh": "列出等待中的下载，支持分页。",
      "params": [
        "offset",
        "num"
      ],
      "params_desc": {
        "offset": "Offset from beginning (0-based)",
        "num": "Number of items to return"
      },
      "outputs": [
        "status",
        "count",
        "downloads",
        "offset",
        "reason"
      ]
    },
    {
      "domain": "aria2",
      "domain_zh": "aria2",
      "action": "stopped",
      "action_zh": "已完成任务",
      "usage": "aria2;stopped,<offset>,<num>",
      "usage_zh": "aria2;stopped,<偏移>,<数量>",
      "description": "List completed/stopped downloads with offset/limit pagination.",
      "description_zh": "列出已完成/已停止的下载，支持分页。",
      "params": [
        "offset",
        "num"
      ],
      "params_desc": {
        "offset": "Offset from beginning (0-based)",
        "num": "Number of items to return"
      },
      "outputs": [
        "status",
        "count",
        "downloads",
        "offset",
        "reason"
      ]
    },
    {
      "domain": "aria2",
      "domain_zh": "aria2",
      "action": "files",
      "action_zh": "下载文件",
      "usage": "aria2;files,<gid>",
      "usage_zh": "aria2;files,<任务GID>",
      "description": "Get list of files in a download with paths and sizes.",
      "description_zh": "获取下载中的文件列表，含路径和大小。",
      "params": [
        "gid"
      ],
      "params_desc": {
        "gid": "Download GID (hex string)"
      },
      "outputs": [
        "status",
        "count",
        "files",
        "gid",
        "reason"
      ]
    },
    {
      "domain": "aria2",
      "domain_zh": "aria2",
      "action": "global-stat",
      "action_zh": "全局统计",
      "usage": "aria2;global-stat",
      "usage_zh": "aria2;global-stat",
      "description": "Get global statistics: download/upload speed, active/waiting/stopped counts.",
      "description_zh": "获取全局统计：下载/上传速度，活动/等待/已完成任务数。",
      "params": [],
      "params_desc": {},
      "outputs": [
        "status",
        "download_speed",
        "num_active",
        "num_stopped",
        "num_stopped_total",
        "num_waiting",
        "raw",
        "upload_speed",
        "reason"
      ]
    },
    {
      "domain": "aria2",
      "domain_zh": "aria2",
      "action": "version",
      "action_zh": "版本信息",
      "usage": "aria2;version",
      "usage_zh": "aria2;version",
      "description": "Get aria2 version and enabled features.",
      "description_zh": "获取 aria2 版本和启用的功能。",
      "params": [],
      "params_desc": {},
      "outputs": [
        "status",
        "enabled_features",
        "raw",
        "version",
        "reason"
      ]
    },
    {
      "domain": "aria2",
      "domain_zh": "aria2",
      "action": "session-info",
      "action_zh": "会话信息",
      "usage": "aria2;session-info",
      "usage_zh": "aria2;session-info",
      "description": "Get aria2 session UUID.",
      "description_zh": "获取 aria2 会话 UUID。",
      "params": [],
      "params_desc": {},
      "outputs": [
        "status",
        "session_id",
        "reason"
      ]
    },
    {
      "domain": "aria2",
      "domain_zh": "aria2",
      "action": "global-option",
      "action_zh": "全局配置",
      "usage": "aria2;global-option",
      "usage_zh": "aria2;global-option",
      "description": "Get current global options (read-only).",
      "description_zh": "获取当前全局配置（只读）。",
      "params": [],
      "params_desc": {},
      "outputs": [
        "status",
        "raw",
        "reason"
      ]
    }
  ],
  "trust": "community"
}
