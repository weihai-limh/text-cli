r"""
{pkg_name} — auto-generated nocode instruction handler.

Generated by readme_to_pkg converter from: {source_file}
Review and adjust:
  - TODO: Verify domain/action names
  - TODO: Add missing entries to knowledge base
  - TODO: Remove unused entries
"""

import json

from core.registry import directive

_ENTRIES = {entries_json}
_KNOWLEDGE_BASE = _ENTRIES


def ok(text):
    """Wrap a successful result in the standard envelope (must return str)."""
    return json.dumps({{"status": "ok", "result": text}}, ensure_ascii=False)


def error(reason):
    """Wrap an error in the standard envelope (must return str)."""
    return json.dumps({{"status": "error", "reason": reason}}, ensure_ascii=False)


def _search(name_val, cond_val):
    """Search knowledge base for entity + condition match."""
    key = name_val.strip().lower()
    cond = cond_val.strip().lower()
    for entry in _KNOWLEDGE_BASE:
        if key in entry["entity"].lower() and cond in entry["condition"].lower():
            return entry["content"]
    return None


def _search_by_entity(name_val):
    """Find all entries for a given entity."""
    key = name_val.strip().lower()
    return [e for e in _KNOWLEDGE_BASE if key in e["entity"].lower()]


def _list_entities():
    """List all known entity names."""
    names = sorted(set(e["entity"] for e in _KNOWLEDGE_BASE), key=str.lower)
    return ", ".join(names)


def _extract_field(content, field):
    """Extract a field value from Markdown list content."""
    sep = "- " + field + ": "
    for line in content.split("\n"):
        if sep.lower() in line.lower():
            return line.split(sep, 1)[1].strip()
    return "(not found)"


@directive("{domain}", "{action}")
def {func_name}(params):
    """Knowledge base search directive.

    Usage: AI:{domain};{action},<{entity_label}>,<{condition_label}>
    """
    if not params:
        return ok("Available: " + _list_entities()
                  + "\nUsage: AI:{domain};{action},<{entity_label}>,<{condition_label}>")

    {entity_label} = params[0]
    {condition_label} = params[1] if len(params) > 1 else ""

    if {condition_label}:
        result = _search({entity_label}, {condition_label})
        if result:
            return ok("=== " + {entity_label} + " — " + {condition_label} + " ===\n\n" + result)

        results = _search_by_entity({entity_label})
        if results:
            lines = ["[" + {entity_label} + "] related advice:\n"]
            for r in results:
                lines.append("  - " + r.get("condition", ""))
                lines.append("    " + _extract_field(r["content"], "reason")[:80])
            return ok("\n".join(lines))
        return ok("Not found: " + {entity_label} + ". Known: " + _list_entities())

    results = _search_by_entity({entity_label})
    if results:
        lines = ["[" + {entity_label} + "] issues:\n"]
        for r in results:
            lines.append("  - " + r.get("condition", ""))
        return ok("\n".join(lines))
    return ok("Not found: " + {entity_label} + ". Known: " + _list_entities())
