{
  "id": "degrade-demo",
  "name": "Degrade Demo",
  "type": "pipeline",
  "version": "0.1.0",
  "mode": "toolchain",
  "description": "Degradation chain: main returns error envelope (status: error) → fallback takes over.",
  "steps": [
    {
      "id": "main",
      "instruction": "test-fail;test,fail",
      "output_as": "main_result",
      "timeout": 5000,
      "degradation": [
        {"id": "fallback", "instruction": "hello;world,degrade-ok", "output_as": "main_result", "timeout": 5000}
      ]
    },
    {"id": "use_result", "instruction": "hello;world,echo-{main_result.result}", "output_as": "final"}
  ]
}
