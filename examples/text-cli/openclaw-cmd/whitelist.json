{
  "tool": "openclaw",
  "commands": [
    {
      "action": "gateway-status",
      "action_cn": "网关状态",
      "args": ["gateway", "status"],
      "args_pattern": "^$",
      "timeout": 10,
      "description": "openclaw gateway status"
    },
    {
      "action": "session-list",
      "action_cn": "会话列表",
      "args": ["sessions"],
      "args_pattern": "^$",
      "timeout": 10,
      "description": "openclaw session list"
    }
  ]
}
