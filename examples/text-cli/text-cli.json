{
  "_schema": "text-cli directive registry v1.0",
  "_updated": "2026-05-09",
  "_note": "机器消费——Agent 路由、Schema 校验、Function Calling。人类文档见各域 _CN.md。",

  "directives": {
    "key_register": {
      "id": "key_register",
      "name": "密钥注册",
      "name_en": "Key Register",
      "category": "密钥",
      "directive": "指令:密钥;注册",
      "description": "将服务密钥通过 XOR 加密传输后注册到本地密钥库，存储时二次加密",
      "parameters": [
        {"name": "service_name", "type": "string", "description": "服务唯一标识"},
        {"name": "cipher_hex", "type": "string", "description": "XOR 加密后的 hex 密文"},
        {"name": "key_type", "type": "string", "enum": ["smtp_password", "api_key", "github_token", "access_token"]}
      ],
      "prompt_template": "指令:密钥;注册,{service_name},{cipher_hex},{key_type}",
      "response_type": "text",
      "response_example": {
        "rst_types": "text",
        "rst_data": {
          "text": "密钥已注册: {service_name}",
          "service": "{service_name}",
          "key_type": "{key_type}"
        }
      },
      "security": {
        "transport": "xor_hex",
        "storage": "aes_local",
        "log_policy": "no_body"
      }
    },

    "key_revoke": {
      "id": "key_revoke",
      "name": "密钥撤销",
      "name_en": "Key Revoke",
      "category": "密钥",
      "directive": "指令:密钥;撤销",
      "description": "从本地密钥库中移除指定服务密钥",
      "parameters": [
        {"name": "service_name", "type": "string", "description": "要撤销的服务标识"}
      ],
      "prompt_template": "指令:密钥;撤销,{service_name}",
      "response_type": "text",
      "response_example": {
        "rst_types": "text",
        "rst_data": {
          "text": "密钥已撤销: {service_name}"
        }
      }
    },

    "key_list": {
      "id": "key_list",
      "name": "密钥列表",
      "name_en": "Key List",
      "category": "密钥",
      "directive": "指令:密钥;列表",
      "description": "列出已注册的服务密钥清单，不返回密钥值",
      "parameters": [],
      "prompt_template": "指令:密钥;列表",
      "response_type": "text",
      "response_example": {
        "rst_types": "text",
        "rst_data": {
          "text": "已注册密钥: N 个",
          "count": 0,
          "services": []
        }
      }
    },

    "file_read": {
      "id": "file_read",
      "name": "文件读取",
      "name_en": "File Read",
      "category": "文件",
      "directive": "指令:文件;读取",
      "description": "读取本地文件内容（UTF-8 编码）",
      "parameters": [
        {"name": "file_path", "type": "string", "description": "文件路径"}
      ],
      "prompt_template": "指令:文件;读取,{file_path}",
      "response_type": "text",
      "response_example": {
        "rst_types": "text",
        "rst_data": {
          "text": "{file_content}",
          "size": 0
        }
      }
    },

    "file_write": {
      "id": "file_write",
      "name": "文件写入",
      "name_en": "File Write",
      "category": "文件",
      "directive": "指令:文件;写入",
      "description": "写入内容到本地文件（自动创建父目录）",
      "parameters": [
        {"name": "file_path", "type": "string", "description": "文件路径"},
        {"name": "content", "type": "string", "description": "写入内容"}
      ],
      "prompt_template": "指令:文件;写入,{file_path},{content}",
      "response_type": "text",
      "response_example": {
        "rst_types": "text",
        "rst_data": {
          "text": "已写入: {file_path}",
          "size": 0
        }
      }
    },

    "file_list": {
      "id": "file_list",
      "name": "文件列表",
      "name_en": "File List",
      "category": "文件",
      "directive": "指令:文件;列表",
      "description": "列出目录内容，返回文件名、类型、大小、修改时间",
      "parameters": [
        {"name": "dir_path", "type": "string", "description": "目录路径（可选，默认当前目录）"}
      ],
      "prompt_template": "指令:文件;列表,{dir_path}",
      "response_type": "text",
      "response_example": {
        "rst_types": "text",
        "rst_data": {
          "text": "[{entries}]",
          "count": 0,
          "directory": "{dir_path}"
        }
      }
    },

    "file_move": {
      "id": "file_move",
      "name": "文件移动",
      "name_en": "File Move",
      "category": "文件",
      "directive": "指令:文件;移动",
      "description": "移动/重命名文件或目录",
      "parameters": [
        {"name": "src_path", "type": "string", "description": "源路径"},
        {"name": "dst_path", "type": "string", "description": "目标路径"}
      ],
      "prompt_template": "指令:文件;移动,{src_path},{dst_path}",
      "response_type": "text",
      "response_example": {
        "rst_types": "text",
        "rst_data": {
          "text": "已移动: {src_path} → {dst_path}",
          "from_path": "{src_path}",
          "to_path": "{dst_path}"
        }
      }
    },

    "git_status": {
      "id": "git_status",
      "name": "Git 状态",
      "name_en": "Git Status",
      "category": "Git",
      "directive": "指令:Git;状态",
      "description": "查看 Git 工作区状态",
      "parameters": [],
      "prompt_template": "指令:Git;状态",
      "response_type": "text",
      "response_example": {
        "rst_types": "text",
        "rst_data": {
          "text": "{git_status_output}"
        }
      }
    },

    "git_push": {
      "id": "git_push",
      "name": "Git 推送",
      "name_en": "Git Push",
      "category": "Git",
      "directive": "指令:Git;推送",
      "description": "推送本地提交到远程仓库",
      "parameters": [
        {"name": "branch", "type": "string", "description": "分支名"}
      ],
      "prompt_template": "指令:Git;推送,{branch}",
      "response_type": "text",
      "response_example": {
        "rst_types": "text",
        "rst_data": {
          "text": "{push_result}",
          "auth_mode": "https|ssh"
        }
      }
    },

    "mail_send": {
      "id": "mail_send",
      "name": "邮件发送",
      "name_en": "Mail Send",
      "category": "邮件",
      "directive": "指令:邮件;发送",
      "description": "通过预配置 SMTP 发送邮件（支持附件）",
      "parameters": [
        {"name": "to", "type": "string", "description": "收件人邮箱"},
        {"name": "subject", "type": "string", "description": "邮件主题"},
        {"name": "body", "type": "string", "description": "邮件正文"},
        {"name": "attachment", "type": "string", "description": "附件路径（可选）"}
      ],
      "prompt_template": "指令:邮件;发送,{to},{subject},{body},{attachment}",
      "response_type": "text",
      "response_example": {
        "rst_types": "text",
        "rst_data": {
          "text": "邮件已发送",
          "subject": "{subject}",
          "from_addr": "{sender}"
        }
      }
    },

    "system_health": {
      "id": "system_health",
      "name": "系统健康",
      "name_en": "System Health",
      "category": "系统",
      "directive": "指令:系统;健康",
      "description": "查看辅助服务器运行状态（运行时间、内存、配置状态）",
      "parameters": [],
      "prompt_template": "指令:系统;健康",
      "response_type": "text",
      "response_example": {
        "rst_types": "text",
        "rst_data": {
          "text": "{health_report}",
          "uptime_seconds": 0,
          "memory_mb": 0,
          "handlers": [],
          "smtp_configured": false,
          "git_token_configured": false
        }
      }
    },

    "system_status": {
      "id": "system_status",
      "name": "系统状态",
      "name_en": "System Status",
      "category": "系统",
      "directive": "指令:系统;状态",
      "description": "查看工作心情（请求统计、错误率、活跃度）",
      "parameters": [],
      "prompt_template": "指令:系统;状态",
      "response_type": "text",
      "response_example": {
        "rst_types": "text",
        "rst_data": {
          "text": "{mood_report}",
          "mood": "relaxed",
          "busy_level": "low",
          "total_requests": 0,
          "error_count": 0,
          "error_rate": 0,
          "requests_per_hour": 0
        }
      }
    },

    "ai_status": {
      "id": "ai_status",
      "name": "AI 状态",
      "name_en": "AI Status",
      "category": "AI协作",
      "directive": "指令:AI协作;状态",
      "description": "查看 AI 协作者当前状态（上下文、压缩、Token 等）",
      "parameters": [
        {"name": "mode", "type": "string", "enum": ["A", "B"], "description": "A=精简, B=要点"}
      ],
      "prompt_template": "指令:AI协作;状态,{mode}",
      "response_type": "text",
      "response_example": {
        "rst_types": "text",
        "rst_data": {
          "text": "{status_report}",
          "model": "{model_name}",
          "context_pct": 0,
          "compactions": 0,
          "health": "ok"
        }
      }
    },

    "terminal_weather": {
      "id": "terminal_weather",
      "name": "天气查询",
      "name_en": "Weather Query",
      "category": "终端",
      "directive": "指令:终端;天气",
      "description": "查询指定城市的实时天气（通过 wttr.in）",
      "parameters": [
        {"name": "city", "type": "string", "description": "城市名"}
      ],
      "prompt_template": "指令:终端;天气,{city}",
      "response_type": "text",
      "response_example": {
        "rst_types": "text",
        "rst_data": {
          "text": "{weather_description}"
        }
      }
    },

    "ai_text": {
      "id": "ai_text",
      "name": "AI 推理",
      "name_en": "AI Text Reasoning",
      "category": "AI辅助",
      "directive": "指令:AI辅助;推理",
      "description": "纯文本推理，多模型回退链。时段感知自动选（0-6时付费模型，6-24时免费模型）",
      "parameters": [
        {"name": "prompt", "type": "string", "description": "推理提示词"},
        {"name": "mode", "type": "string", "enum": ["auto", "fast", "quality"], "description": "auto=时段感知, fast=免费链, quality=付费链，或直接模型名"}
      ],
      "prompt_template": "指令:AI辅助;推理,{prompt},{mode}",
      "response_type": "text",
      "response_example": {
        "rst_types": "text",
        "rst_data": {
          "text": "{reasoning_result}"
        }
      }
    },

    "ai_vision": {
      "id": "ai_vision",
      "name": "AI 视觉",
      "name_en": "AI Vision Reasoning",
      "category": "AI辅助",
      "directive": "指令:AI辅助;视觉",
      "description": "视觉推理（文本+图片），支持 URL 或 base64",
      "parameters": [
        {"name": "prompt", "type": "string", "description": "推理提示词"},
        {"name": "image_url", "type": "string", "description": "图片 URL (http/https) 或 base64 data URI"},
        {"name": "mode", "type": "string", "enum": ["auto", "fast", "quality"], "description": "模型选择"}
      ],
      "prompt_template": "指令:AI辅助;视觉,{prompt},{image_url},{mode}",
      "response_type": "text",
      "response_example": {
        "rst_types": "text",
        "rst_data": {
          "text": "{vision_result}"
        }
      }
    },

    "sem_encode": {
      "id": "sem_encode",
      "name": "语义编码",
      "name_en": "Semantic Encode",
      "category": "语义",
      "directive": "指令:语义;编码",
      "description": "将文本编码为语义向量（embedding-3 在线 API）",
      "parameters": [
        {"name": "text", "type": "string", "description": "待编码文本"},
        {"name": "dimensions", "type": "string", "enum": ["A", "B", "C", "D"], "description": "A=256/B=512/C=1024/D=2048，默认B"}
      ],
      "prompt_template": "指令:语义;编码,{text},{dimensions}",
      "response_type": "text",
      "response_example": {
        "rst_types": "text",
        "rst_data": {
          "text": "已编码 (512维)\n预览: [0.014523, -0.003421, ...]..."
        }
      }
    },

    "sem_similarity": {
      "id": "sem_similarity",
      "name": "语义相似",
      "name_en": "Semantic Similarity",
      "category": "语义",
      "directive": "指令:语义;相似",
      "description": "计算两段文本的余弦相似度",
      "parameters": [
        {"name": "text_a", "type": "string", "description": "文本 A"},
        {"name": "text_b", "type": "string", "description": "文本 B"},
        {"name": "dimensions", "type": "string", "enum": ["A", "B", "C", "D"], "description": "维度模式，默认B"}
      ],
      "prompt_template": "指令:语义;相似,{text_a},{text_b},{dimensions}",
      "response_type": "text",
      "response_example": {
        "rst_types": "text",
        "rst_data": {
          "text": "相似度: 92.3%\n判定: 高度相似"
        }
      }
    },

    "sem_match": {
      "id": "sem_match",
      "name": "语义匹配",
      "name_en": "Semantic Match",
      "category": "语义",
      "directive": "指令:语义;匹配",
      "description": "从候选中找出语义最匹配的一项",
      "parameters": [
        {"name": "query", "type": "string", "description": "查询文本"},
        {"name": "candidates", "type": "array", "description": "候选文本列表（逗号分隔）"},
        {"name": "dimensions", "type": "string", "enum": ["A", "B", "C", "D"], "description": "维度模式，默认B"}
      ],
      "prompt_template": "指令:语义;匹配,{query},{candidate_1},{candidate_2},...,{dimensions}",
      "response_type": "text",
      "response_example": {
        "rst_types": "text",
        "rst_data": {
          "text": "最佳匹配 (85.6%): {best_match}"
        }
      }
    },

    "encode_base64": {
      "id": "encode_base64",
      "name": "Base64 编解码",
      "name_en": "Base64 Encode/Decode",
      "category": "编码",
      "directive": "指令:编码;base64",
      "description": "Base64 编解码",
      "parameters": [
        {"name": "mode", "type": "string", "enum": ["encode", "decode"], "description": "encode=编码, decode=解码"},
        {"name": "content", "type": "string", "description": "内容"}
      ],
      "prompt_template": "指令:编码;base64,{mode},{content}",
      "response_type": "text",
      "response_example": {
        "rst_types": "text",
        "rst_data": {
          "text": "{result}"
        }
      }
    },

    "encode_hex": {
      "id": "encode_hex",
      "name": "Hex 编解码",
      "name_en": "Hex Encode/Decode",
      "category": "编码",
      "directive": "指令:编码;hex",
      "description": "Hex 编解码",
      "parameters": [
        {"name": "mode", "type": "string", "enum": ["encode", "decode"], "description": "encode=编码, decode=解码"},
        {"name": "content", "type": "string", "description": "内容"}
      ],
      "prompt_template": "指令:编码;hex,{mode},{content}",
      "response_type": "text",
      "response_example": {
        "rst_types": "text",
        "rst_data": {
          "text": "{result}"
        }
      }
    }
  }
}
